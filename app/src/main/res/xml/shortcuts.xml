<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="get_torus_score"
        android:enabled="true"
        android:icon="@drawable/ic_filter_list"
        android:shortcutShortLabel="@string/get_item_short"
        android:shortcutLongLabel="@string/get_item_long"
        android:shortcutDisabledMessage="@string/label_disabled">
        <capability android:name="actions.intent.GET_THING">
            <intent
                android:action="android.intent.action.VIEW"
                android:targetPackage="dev.brunofelix.fitactions"
                android:targetClass="dev.brunofelix.fitactions.tasks.TasksActivity">
                <parameter
                    android:name="thing.name"
                    android:key="q"/>
            </intent>
        </capability>
    </shortcut>
</shortcuts>
